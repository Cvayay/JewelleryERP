<UserControl x:Class="JewelleryERP.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Form Panel -->
        <Border Grid.Column="0" Background="#F8F9FA" Padding="15" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Customer Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Name *" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6"/>

                <TextBlock Text="Phone Number" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6"/>

                <TextBlock Text="Email" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6"/>

                <TextBlock Text="GST Number" FontWeight="SemiBold"/>
                <TextBox Text="{Binding GstNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6"/>

                <TextBlock Text="Address" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,15" Padding="6"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear" Command="{Binding ClearCommand}" Width="70" Margin="0,0,8,0" Padding="6"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Width="70" Margin="0,0,8,0" Padding="6" Background="#DC3545" Foreground="White"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Padding="6" Background="#0D6EFD" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Data Grid Panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </DockPanel>

            <!-- Table -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GstNumber}" Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>