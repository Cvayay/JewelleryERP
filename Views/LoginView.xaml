<UserControl x:Class="JewelleryERP.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:JewelleryERP.Helpers"
             xmlns:viewmodels="clr-namespace:JewelleryERP.ViewModels">
    
    <UserControl.DataContext>
        <viewmodels:LoginViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            
            <TextBlock Text="Om Prakash Jewellers" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Username" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Height="30" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Password" Margin="0,0,0,5" FontWeight="SemiBold"/>
            
            <!-- Using your PasswordBoxAssistant here! -->
            <PasswordBox helpers:PasswordBoxAssistant.Attach="True"
                         helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                       HorizontalAlignment="Center" Margin="0,0,0,10" 
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button Content="Login" Command="{Binding LoginCommand}" 
                    Height="35" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            
        </StackPanel>
    </Grid>
</UserControl>