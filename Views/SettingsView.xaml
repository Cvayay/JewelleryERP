<UserControl x:Class="JewelleryERP.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JewelleryERP.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Settings"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Configure shop details, tax values, rates, and billing defaults."
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Grid.Column="0"
                          Header="Shop Information"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrushLight}"
                          Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Shop Name"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2"
                                   Text="Address"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4"
                                   Text="GSTIN"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="0"
                          Grid.Column="2"
                          Header="Bill Branding"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrushLight}"
                          Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Shop Logo Path"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Text="{Binding ShopLogoPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Grid.Row="2"
                                   Text="(e.g., logo.png)"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Grid.Row="4"
                                   Text="Shop Stamp Path"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Text="{Binding ShopStampPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Grid.Row="6"
                                   Text="(e.g., stamp.png)"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2"
                          Grid.Column="0"
                          Header="Metal Rates"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrushLight}"
                          Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Gold Rate (₹)"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentGoldRate, UpdateSourceTrigger=PropertyChanged, StringFormat=₹ {0:N2}}" />

                        <TextBlock Grid.Row="2"
                                   Text="Silver Rate (₹)"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding CurrentSilverRate, UpdateSourceTrigger=PropertyChanged, StringFormat=₹ {0:N2}}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2"
                          Grid.Column="2"
                          Header="Tax &amp; Billing"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrushLight}"
                          Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="CGST"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Cgst, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />

                        <TextBlock Grid.Row="2"
                                   Text="SGST"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding Sgst, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />

                        <TextBlock Grid.Row="4"
                                   Text="Current Bill Number"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding CurrentBillNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6"
                                   Text="Default Interest Rate"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Text="{Binding DefaultInterestRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                    </Grid>
                </GroupBox>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       Margin="0,16,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
