<Window x:Class="JewelleryERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JewelleryERP"
        Height="900"
            Width="1501"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="K"
                    Modifiers="Control"
                    Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding CloseCommandPaletteCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid>
                        <TextBlock Text="JewelleryERP"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="☰"
                                Command="{Binding ToggleNavigationCommand}"
                                HorizontalAlignment="Right"
                                Width="38"
                                Height="38"
                                Padding="0"
                                ToolTip="Collapse navigation" />
                    </Grid>
                    <TextBlock Text="{Binding CurrentUserName}"
                               Foreground="#D1D5DB"
                               FontSize="12"
                               Margin="0,10,0,0"
                               Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding CurrentRole}"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowDashboardViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Dashboard" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowCustomerViewCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE716;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Customers" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowProductViewCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8D2;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Products" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowInvoiceViewCommand}"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8A1;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Invoices" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowLoanViewCommand}"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8D7;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Pledge / Loan" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}} />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowCustomerLedgerViewCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE71B;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Ledger" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}} />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSettingsViewCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Settings" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}} />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8AC;"
                                       FontSize="16"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Logout" Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}} />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Padding="10"
                        Background="#1F2937"
                        BorderBrush="#374151"
                        BorderThickness="1"
                        Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="PROFILE"
                                   FontSize="10"
                                   Foreground="#9CA3AF" />
                        <TextBlock Text="{Binding CurrentUserName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DatabaseHealth}"
                                   Foreground="#D6B15C"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <ContentControl Content="{Binding CurrentView}" />

            <Border Background="#66000000"
                    Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Width="620"
                        MaxHeight="520"
                        VerticalAlignment="Top"
                        Margin="0,80,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#D6B15C"
                        BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 Padding="12"
                                 ToolTip="Search modules, bills, pledges, customers, and stock" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CommandPaletteResults}"
                                 BorderThickness="0"
                                 Margin="0,12,0,0"
                                 SelectedValuePath="Target">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="12"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
