    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D9E0" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#D6B15C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B8860B" />
