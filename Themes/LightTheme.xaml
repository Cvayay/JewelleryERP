<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SidebarBgColor">#111827</Color>
    <Color x:Key="ShellBgColor">#F3F4F6</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="NavButtonBgColor">#1F2937</Color>
    <Color x:Key="NavButtonHoverColor">#374151</Color>
    <Color x:Key="NavButtonActiveColor">#4B3A18</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
