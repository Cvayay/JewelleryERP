    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#E7C66A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E7C66A" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#CBD5E1" />
</ResourceDictionary>
