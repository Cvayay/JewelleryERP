<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SidebarBgColor">#0B1120</Color>
    <Color x:Key="ShellBgColor">#0F172A</Color>
    <Color x:Key="CardBgColor">#1E293B</Color>
    <Color x:Key="NavButtonBgColor">#172033</Color>
    <Color x:Key="NavButtonHoverColor">#263449</Color>
    <Color x:Key="NavButtonActiveColor">#59451D</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="AccentGoldColor">#E7C66A</Color>
    <Color x:Key="AccentColor">#E7C66A</Color>
    <Color x:Key="SidebarTextColor">#F8FAFC</Color>
    <Color x:Key="SidebarMutedTextColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#0B1120" />
    <SolidColorBrush x:Key="ShellBgBrush" Color="#0F172A" />
